# Copier en .env. Aucune de ces variables n'est nécessaire pour `npm run marketing:demo`.

# --- Génération ---
# api | fixture | off. Par défaut : `api` si MISTRAL_API_KEY est présente, sinon `fixture`.
# `fixture` rejoue une réponse locale : aucun réseau, aucun secret, démarrage en secondes.
MISTRAL_MODE=fixture
# Requise uniquement en MISTRAL_MODE=api.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# --- File de validation ---
# Obligatoire dès que la page est exposée ailleurs que sur 127.0.0.1.
# La file approuve du contenu publié sous ton identité réelle : elle doit être
# protégée par un contrôle de rôle, pas seulement par une session valide.
MARKETING_ADMIN_TOKEN=
MARKETING_PORT=4321

# --- Base ---
# Absente : le dépôt en mémoire est utilisé (démo, tests). Rien n'est persisté.
# Renseignée : le dépôt MariaDB prend le relais. DDL : `npm run marketing -- db:print-ddl`.
DATABASE_URL=

# --- Diffusion LinkedIn (phase 2) ---
# Interrupteur global. `false` coupe toute publication sans déploiement.
MARKETING_ENABLED=true

# Console développeur LinkedIn. Le redirect_uri doit être IDENTIQUE à celui déclaré.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://contractshield.fr/admin/marketing/oauth/linkedin

# Version d'API, en-tête LinkedIn-Version. Elles tournent chaque trimestre :
# à confirmer dans la console développeur avant la première publication.
LINKEDIN_API_VERSION=202601

# Échappement du champ `commentary` (format « petit texte »).
# `true` par défaut. Si le premier post réel sort avec des barres obliques
# visibles dans les URL, passer à `false` : aucun changement de code requis.
LINKEDIN_ESCAPE_COMMENTARY=true

# Chiffrement des jetons au repos. Plusieurs clés séparées par des virgules,
# la première étant celle d'écriture. Garde l'ancienne pendant une rotation.
# Générer : node -e "console.log('1:'+require('crypto').randomBytes(32).toString('base64'))"
MARKETING_TOKEN_KEY=

# Canal d'alerte indépendant de Brevo. Sans lui, une panne du fournisseur
# d'e-mail rendrait les alertes muettes au moment où elles comptent.
WEBHOOK_ALERT_URL=

# Le process doit tourner en UTC : sinon un post prévu à 02h30 le dimanche du
# changement d'heure ne part jamais, ou part deux fois.
TZ=UTC
